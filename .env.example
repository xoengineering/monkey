# Copy this file to .env (gitignored, never committed) to set your
# Apple Developer Team ID for script/run, so you don't have to prefix it
# every time. Find your team ID with: security find-identity -v -p codesigning
#
# This is sourced directly by script/run as a plain shell script and passed
# to xcodebuild as a trailing command-line override — it never touches
# project.yml, Local.xcconfig, or xcodegen, so it can never leak into the
# tracked project.pbxproj (see the comment in App/Local.xcconfig.example for
# why that matters).

# export DEVELOPMENT_TEAM=YOURTEAMID
