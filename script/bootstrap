#!/bin/sh
set -e

cd "$(dirname "$0")/.."

if [ ! -f App/Local.xcconfig ]; then
  cp App/Local.xcconfig.example App/Local.xcconfig
  echo "Created App/Local.xcconfig — edit it with your own PRODUCT_BUNDLE_IDENTIFIER before building the app target."
fi

if [ ! -f .env ]; then
  cp .env.example .env
  echo "Created .env — edit it with your own DEVELOPMENT_TEAM before running script/run."
fi

swift package resolve

cd App && xcodegen generate
